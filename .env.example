APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Require two-factor authentication for every panel account (recommended: on).
# An account without it is walked through enrolment on next login, not locked
# out. Set to false only for a deliberate password-only setup.
VPNFORGE_REQUIRE_MFA=true

# Automatic backups of the database and every key on the box.
#   VPNFORGE_BACKUP_SCHEDULE   off | daily | weekly   (the installer sets daily)
#   VPNFORGE_BACKUP_KEEP       how many local archives to keep before pruning
#   VPNFORGE_BACKUP_OFFSITE_DISK  a filesystem disk (e.g. s3) to also upload to
# The archive contains all private key material -- keep any offsite target private.
VPNFORGE_BACKUP_SCHEDULE=off
VPNFORGE_BACKUP_KEEP=7
# VPNFORGE_BACKUP_OFFSITE_DISK=s3

# Days before a user's expires_at to raise a one-off operator "expiring soon"
# alert (de-duplicated per user per expiry). This same window also gates the
# end-user "your access is about to expire" email, so 0 disables both.
VPNFORGE_EXPIRY_WARN_DAYS=3

# External heartbeat (dead man's switch). When set, the scheduler pings this
# URL so a fully-dead box -- worker down, internal alerting silent -- is still
# noticed by an off-host monitor (e.g. a healthchecks.io / Uptime Kuma push URL).
# Leave empty to disable. The URL is the only secret; keep it private.
# VPNFORGE_HEARTBEAT_URL=https://hc-ping.com/your-uuid-here
VPNFORGE_HEARTBEAT_STATUS=true

# DNS blocking dashboard: seconds to cache the 24h/7d rollups (range scans over
# a large table), and how many domains the "top blocked" table lists.
VPNFORGE_BLOCKING_CACHE_TTL=60
VPNFORGE_BLOCKING_TOP_LIMIT=10

# Encrypt each backup archive at rest with this passphrase (openssl AES-256-CBC,
# PBKDF2). Empty (the default) keeps the plaintext .zip. Stored ONLY here, never
# inside the archive -- lose it and an encrypted backup cannot be restored.
# VPNFORGE_BACKUP_PASSPHRASE=

# Prometheus /metrics endpoint for a monitoring scraper. Empty = disabled (404).
# Set a long random string; the scraper presents it as a bearer token. Output is
# counts and per-service up/down only -- no keys, addresses or user data.
# VPNFORGE_METRICS_TOKEN=

# End-user email notifications (access expiring / connection from a new network).
# Only sent when the user has an email set AND a real mailer is configured.
VPNFORGE_USER_MAIL_ENABLED=true

# Bulk CSV import cap (service users -> "Import CSV"). 0 = no cap.
VPNFORGE_IMPORT_MAX_ROWS=1000

# Optional GeoIP enrichment of connection logs (DB-IP Lite, CC-BY). The installer
# downloads the databases to /etc/vpnforge/geoip; monthly | off.
VPNFORGE_GEOIP_REFRESH=monthly
# VPNFORGE_GEOIP_COUNTRY_DB=/etc/vpnforge/geoip/dbip-country-lite.mmdb
# VPNFORGE_GEOIP_ASN_DB=/etc/vpnforge/geoip/dbip-asn-lite.mmdb

VITE_APP_NAME="${APP_NAME}"

// vpnforge-worker runs its per-service VPN commands (wg, easyrsa,
// iptables) via a Linux capability (CAP_NET_ADMIN, ambient), but enabling,
// starting, restarting or disabling the systemd units around those (wg-
// quick@, openvpn-server@, vpnforge-dnsmasq@) goes through systemd's D-Bus
// API instead, which is gated by polkit rather than by capabilities --
// without this rule polkit falls back to requiring interactive
// authentication, which a non-interactive system service can never
// provide. NoNewPrivileges=yes on the worker unit rules out sudo as an
// alternative fix (sudo itself needs a new-privilege execve to elevate),
// so this is the mechanism that actually works for this specific gap.
//
// Scoped to only the units this app manages. An unscoped rule would let a
// compromised worker start, stop, restart or mask ANY unit on the system --
// including root-run ones -- which is a straight escalation out of the
// CAP_NET_ADMIN sandbox the rest of the design works to keep it inside.
// The unit name is read from the action, and only the vpnforge-managed
// prefixes are permitted.
polkit.addRule(function(action, subject) {
    if (subject.user != "vpnforge-worker") {
        return;
    }

    if (action.id != "org.freedesktop.systemd1.manage-units" &&
        action.id != "org.freedesktop.systemd1.manage-unit-files") {
        return;
    }

    var unit = action.lookup("unit");

    // The start/stop/restart/kill action (manage-units) always names its
    // unit, so it is scoped strictly to the vpnforge-managed prefixes -- this
    // is the one that would let a compromised worker act on an arbitrary
    // root-run unit, and it is fully closed.
    if (unit != null) {
        var allowed = ["wg-quick@", "openvpn-server@", "vpnforge-dnsmasq@"];

        for (var i = 0; i < allowed.length; i++) {
            if (unit.indexOf(allowed[i]) == 0) {
                return polkit.Result.YES;
            }
        }

        return; // any other named unit: deny
    }

    // The enable/disable/mask action (manage-unit-files) does not carry a
    // per-unit detail, so it cannot be scoped the same way. It is allowed,
    // because the residual power it grants -- masking a unit, or enabling one
    // -- requires writing under /etc/systemd, which the worker's hardened unit
    // (ProtectSystem=strict, /etc/systemd not in ReadWritePaths) forbids. The
    // dangerous "act on an arbitrary running unit" path is manage-units above,
    // which is scoped.
    return polkit.Result.YES;
});
